{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NightSpark",
  "version": "0.1.0",
  "identifier": "com.toxic.nightspark",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NightSpark",
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "copyright": "Copyright (c) 2026 毒狐 (Nopekios). Licensed under the MIT License.",
    "resources": {
      "../LICENSE": "LICENSE"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBCNTVDNzRGNTA3NTZCNTUKUldSVmEzVlFUOGRWQzBscmIvalBaQXZCNXR3YWtxL2EwVUUvUlRKbzB0U3o0czB3S0lMMkhOcmkK",
      "endpoints": [
        "https://github.com/Nopekios/NightSpark-Launcher/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
