# 默认：Git 自动识别文本文件，并对仓库内文本统一使用 LF
* text=auto eol=lf

# 明确为文本的源码与配置，强制 LF，避免 Windows CRLF 污染仓库
*.rs      text eol=lf
*.toml    text eol=lf
*.json    text eol=lf
*.ts      text eol=lf
*.vue     text eol=lf
*.js      text eol=lf
*.css     text eol=lf
*.html    text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.svg     text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf

# 二进制资源：不做换行符转换，也不做文本 diff
*.png   binary
*.ico   binary
*.icns  binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.zip   binary
*.exe   binary
*.dll   binary
*.lib   binary
*.pdb   binary

# 锁文件：由工具生成，不参与合并冲突处理
package-lock.json  -diff
Cargo.lock         -diff
